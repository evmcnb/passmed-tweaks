{
  "manifest_version": 3,
  "name": "Tweaks for Passmedicine",
  "version": "1.0.4",
  "description": "Unofficial add-on for Passmedicine: themes, score hiding, blind blocks, cover test, better comments, question insights and stats.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tweaks for Passmedicine",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.passmedicine.com/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.passmedicine.com/*"],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{ead1aaad-ddb3-4e29-87ed-7a1956bdfcfc}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
